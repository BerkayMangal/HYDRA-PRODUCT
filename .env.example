# Docker: --env-file .env. Bare Python reads exported variables, not this file.
PORT=8080
HYDRA_MODE=dashboard
HYDRA_WALLET_MONITOR_ENABLED=true

# Public market and wallet data work without account keys.
# Configure optional providers in Railway Variables when required.
HYDRA_OKX_API_KEY=
HYDRA_OKX_SECRET=
HYDRA_OKX_PASSPHRASE=
HYDRA_COINGLASS_KEY=
HYDRA_CRYPTOQUANT_KEY=
HYDRA_FRED_KEY=
HYDRA_TELEGRAM_TOKEN=
HYDRA_TELEGRAM_CHAT=

# Keep ml.enabled: false in the YAML configuration for this release.
